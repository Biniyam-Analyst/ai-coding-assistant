# ==============================================================================
# AI Coding Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure your credentials locally:
#   copy .env.example .env            (Windows Command Prompt)
#   Copy-Item .env.example .env       (Windows PowerShell)
#
# IMPORTANT:
# - Never commit or share your real .env file.
# - Keep API keys strictly private.
# - You only need to configure the credentials for the provider you want to use.
# - All default model names, free-tier availability, pricing, and billing
#   requirements are provisional. Verify them against official documentation.
# ==============================================================================

# --- Google Gemini Configuration ---
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Verify model availability and tier details in Google's official documentation.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI Configuration (Optional / Phase 6) ---
# Obtain an API key from OpenAI Platform: https://platform.openai.com/
# Verify model availability and billing requirements in OpenAI's official documentation.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude Configuration (Optional / Phase 6) ---
# Obtain an API key from Anthropic Console: https://console.anthropic.com/
# Verify model availability and billing requirements in Anthropic's official documentation.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
